# Supabase Config
SUPABASE_URL=your_supabase_project_url
# Use the SERVICE ROLE KEY (not anon key) — bypasses RLS for backend operations
SUPABASE_KEY=your_supabase_service_role_key
# Anon (publishable) key — used ONLY to verify user JWTs with least privilege.
# Strongly recommended; if unset, JWT verification falls back to the service key.
SUPABASE_ANON_KEY=your_supabase_anon_key

# NVIDIA NIM API Keys for LLM Racing Engine (at least 1 required for AI features)
NVIDIA_NIM_API_KEY_DEEPSEEK=nvapi-xxxxxx
NVIDIA_NIM_API_KEY_META=nvapi-xxxxxx
NVIDIA_NIM_API_KEY_GEMMA=nvapi-xxxxxx

# Optional integrations (all safe to leave blank — features degrade gracefully)
# Magical API key for resume parsing/enrichment
MAGICAL_API_KEY=
# GitHub token — higher rate limits + richer applicant GitHub stats
GITHUB_TOKEN=
# Pre-warm the embedding model on startup (slower boot, faster first match)
WARM_EMBEDDING_MODEL=false

# Admin access — comma-separated email allowlist. Users with profiles.role='admin'
# are also granted access. Defaults to the legacy admin if unset.
ADMIN_EMAILS=admin@example.com
ADMIN_MASTER_KEY=your_secure_admin_master_key

# CORS — comma-separated allowed origins (defaults cover localhost + the prod domain)
CORS_ORIGINS=http://localhost:5173,https://hiresense.pages.dev

# Interactive API docs at /docs — set to false in production
ENABLE_DOCS=true

# Rate limiting (per IP). Generous default; tighten in production.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=60
