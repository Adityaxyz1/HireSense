# Environment secrets — env files now live in backend_v3/env/
# Re-include the env/ dir first (repo-root .gitignore has ENV/ which, on
# case-insensitive filesystems, would otherwise ignore this whole folder).
!env/
env/.env*
!env/.env.example
# (legacy: only a root-level .env, anchored with / so it doesn't clobber env/)
/.env
/.env.*
!/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/

# IDE
.vscode/
.idea/

# Logs
*.log
server.log

# Data uploads
data/uploads/

# Node (if any)
node_modules/