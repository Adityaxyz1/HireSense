# ─────────────────────────────────────────────────────────────
#  HireSense  ·  Backend API  ·  Environment variables
#  Copy this file to .env and fill in your values.
#  Never commit .env — it contains secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
# Service Role Key — full DB access, bypasses RLS. Backend-only, never expose to clients.
SUPABASE_KEY=your_supabase_service_role_key
# Anon (publishable) key — used ONLY to verify user JWTs with least privilege.
# Strongly recommended; falls back to the service key if unset (logs a warning).
SUPABASE_ANON_KEY=your_supabase_anon_key

# ── AI / LLM ─────────────────────────────────────────────────
# NVIDIA NIM Racing Engine — at least 1 key required for AI features.
# Add up to 3 keys (different models) for resilience and faster responses.
NVIDIA_NIM_API_KEY_DEEPSEEK=nvapi-xxxxxx
NVIDIA_NIM_API_KEY_META=nvapi-xxxxxx
NVIDIA_NIM_API_KEY_GEMMA=nvapi-xxxxxx

# ── Redis (rate limiting + Celery broker) ────────────────────
# Shared Redis instance — used by the API for distributed rate limiting
# AND by Celery workers as the task broker.
# Local dev default works if Redis is running on localhost:6379.
REDIS_URL=redis://localhost:6379/0

# ── Optional integrations ────────────────────────────────────
# Magical API — resume parsing/enrichment (leave blank to skip)
MAGICAL_API_KEY=
# GitHub token — raises public API rate limit (60 → 5000 req/hr)
GITHUB_TOKEN=
# Pre-warm the SentenceTransformer model on startup.
# false = lazy-load on first use (faster boot, slower first match).
# true  = warm on startup (slower boot, instant first match).
WARM_EMBEDDING_MODEL=false

# ── Admin ─────────────────────────────────────────────────────
# Comma-separated email allowlist. Users with profiles.role='admin' also get access.
ADMIN_EMAILS=admin@example.com

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://hiresense.pages.dev

# ── API docs ─────────────────────────────────────────────────
# OFF by default (safe for production). Set true in local dev to expose /docs.
ENABLE_DOCS=false

# ── Rate limiting ─────────────────────────────────────────────
# Max requests per IP per window. Shared via Redis across all workers.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=60
