# Environment secrets — env files now live in frontend/env/
# Re-include the env/ dir first (repo-root .gitignore has ENV/ which, on
# case-insensitive filesystems, would otherwise ignore this whole folder).
!env/
env/.env*
!env/.env.example
# (legacy: only a root-level .env, anchored with / so it doesn't clobber env/)
/.env
/.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
