# ─────────────────────────────────────────────────────────────
#  HireSense · Frontend (Vite/React) · Environment template
#
#  Vite reads env files from this folder (envDir: 'env' in vite.config.js)
#  and auto-selects by mode:
#     npm run dev   → env/.env.development   (local)
#     npm run build → env/.env.production    (deployed)
#
#  Copy this file to .env.development (and .env.production) and fill in
#  values. All vars MUST be prefixed with VITE_ to reach the browser
#  bundle. VITE_* values are PUBLIC — use the Supabase ANON key only,
#  never a secret/service-role key.
# ─────────────────────────────────────────────────────────────

# ── Supabase (use the ANON key — NOT the service role key) ───
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Backend API ───────────────────────────────────────────────
# Local dev:   http://localhost:8000/api
# Production:  https://<your-render-api>/api  (also set in Cloudflare Pages)
VITE_API_URL=http://localhost:8000/api
